{
  "manifest_version": 3,
  "name": "Flint — AI Usage Guardian",
  "description": "Your AI guardian. Built for builders. Helps you write better prompts and track your AI usage.",
  "version": "1.0.0",
  "icons": {
    "16": "public/icons/icon-16.png",
    "48": "public/icons/icon-48.png",
    "128": "public/icons/icon-128.png"
  },
  "permissions": ["storage", "sidePanel", "activeTab", "alarms"],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/content/index.tsx"],
      "css": []
    }
  ],
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "action": {
    "default_title": "Open Flint"
  }
}
